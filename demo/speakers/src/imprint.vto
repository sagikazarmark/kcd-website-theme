---
id: imprint
title: Imprint
description: "Legal notice for the KCD Your City 2099 website and ticket shop. Operator, registration data and ticketing partner."
---
{{ layout "layouts/page.vto" }}

{{# The operator, its registration data and the ticketing partner are this
    page's copy, the names used more than once set below. The demo entity is
    fictional: fill this in from the official register, with whatever your
    jurisdiction requires. The terms languages are the keys of `terms`. #}}
{{ set operator = "Your City Cloud Native Association" }}
{{ set email = "hello@example.com" }}
{{ set ticketing = "pretix GmbH" }}
{{ set languageNames = new Intl.DisplayNames(["en"], { type: "language" }) }}
{{ set termsLanguages = Object.entries(terms)
    .sort(([a, va], [b, vb]) => (va.order ?? 0) - (vb.order ?? 0) || a.localeCompare(b))
    .map(([lang]) => languageNames.of(lang)) }}
{{ set termsLanguageList = termsLanguages.length > 1
    ? `${termsLanguages.slice(0, -1).join(", ")} and ${termsLanguages.at(-1)}`
    : termsLanguages[0] }}

{{ comp ui.section { width: "3xl" } }}
    {{ comp.ui.heading({ level: 1, pill: "Legal", title: "Imprint" }) }}

    <div class="space-y-6">
        <!-- Operator -->
        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
            <h2 class="mb-4 text-2xl font-bold text-primary">Operator</h2>
            <p class="mb-4 leading-7 text-gray-700">
                This website and the {{ event.name }} ticket shop are operated by
            </p>
            <address class="not-italic leading-7 text-gray-700">
                <p class="text-xl font-semibold text-black">Your City Cloud Native Association</p>
                <p>({{ operator }})</p>
                <p class="mt-3">
                    2 Example Street<br />
                    1000 Your City<br />
                    Demoland
                </p>
                <p class="mt-3">
                    Email:
                    <a
                        href="mailto:{{ email }}"
                        class="font-semibold text-primary underline decoration-secondary underline-offset-4 transition hover:text-accent"
                    >{{ email }}</a>
                </p>
            </address>
        </section>

        <!-- Registration -->
        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
            <h2 class="mb-4 text-2xl font-bold text-primary">Registration</h2>
            <dl class="grid grid-cols-1 gap-x-8 gap-y-3 leading-7 text-gray-700 sm:grid-cols-[max-content_1fr]">
                <dt class="font-semibold text-black">Authorised representative</dt>
                <dd>Bram Placeholder, chair</dd>

                <dt class="font-semibold text-black">Company registration number</dt>
                <dd>00-00-000000</dd>

                <dt class="font-semibold text-black">Registering court</dt>
                <dd>Your City Registry Court</dd>

                <dt class="font-semibold text-black">Tax number</dt>
                <dd>00000000-0-00</dd>

                <dt class="font-semibold text-black">EU VAT ID</dt>
                <dd>XX00000000</dd>
            </dl>
        </section>

        <!-- Ticketing -->
        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
            <h2 class="mb-4 text-2xl font-bold text-primary">Ticketing partner</h2>
            <p class="mb-4 leading-7 text-gray-700">
                Ticket orders and payments are processed through the pretix
                ticketing platform, provided by
            </p>
            <p class="leading-7 text-gray-700">
                <a
                    href="https://pretix.eu/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-primary underline decoration-secondary underline-offset-4 transition hover:text-accent"
                >{{ ticketing }}</a><br />
                Berthold-Mogel-Straße 1, 69126 Heidelberg, Germany
            </p>
            <p class="mt-4 leading-7 text-gray-700">
                {{ ticketing }} provides the software and payment
                processing only. The seller of the tickets, and your contractual
                partner, is {{ operator }} as named above. See also the
                <a
                    href="https://pretix.eu/about/en/imprint"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-primary underline decoration-secondary underline-offset-4 transition hover:text-accent"
                >pretix legal notice</a>
                and
                <a
                    href="https://pretix.eu/about/en/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-primary underline decoration-secondary underline-offset-4 transition hover:text-accent"
                >privacy policy</a>.
            </p>
            <p class="mt-4 leading-7 text-gray-700">
                Ticket orders and attendance are governed by our
                <a
                    href="{{ search.page("id=terms").url }}"
                    class="font-semibold text-primary underline decoration-secondary underline-offset-4 transition hover:text-accent"
                >Terms and Conditions</a>, available in {{ termsLanguageList }}.
            </p>
        </section>

        <!-- Trademarks -->
        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
            <h2 class="mb-4 text-2xl font-bold text-primary">Trademarks</h2>
            <p class="leading-7 text-gray-700">
                Kubernetes Community Days and the KCD logo are trademarks of The
                Linux Foundation, used under the Cloud Native Computing
                Foundation's KCD program. {{ event.name }} is organised
                independently by the local community; it is not operated by
                The Linux Foundation or the CNCF.
            </p>
        </section>
    </div>
{{ /comp }}
