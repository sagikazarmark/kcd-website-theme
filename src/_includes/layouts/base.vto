{{#
    The <html> shell: head (title, description, link preview, stylesheet,
    the theme script) and body. Slots travel up the layout chain by
    themselves; `head` adds markup to <head>
    (`{{ slot head }}{{ comp.pretix.head() }}{{ /slot }}`).

    Front matter: title (the <title> prefix), description (meta and link
    preview; default `share.description`), shareImage (default
    `share.image`), lang (default "en"), bodyClass.
#}}
<!doctype html>
{{ set siteTitle = `${event.name} ${event.year}` }}
<html lang="{{ lang || 'en' }}">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{ if title }}{{ title }} - {{ siteTitle }}{{ else }}{{ siteTitle }}{{ /if }}</title>
        {{ if description }}
            <meta name="description" content="{{ description }}" />
        {{ /if }}

        {{# Link preview from `share`; the URLs must be absolute, scrapers do not resolve relative ones. #}}
        {{ set shareTitle = title ? `${title} - ${siteTitle}` : siteTitle }}
        {{ set shareText = description || share.description }}
        {{ set shareImageUrl = (shareImage || share.image) |> url(true) }}
        <link rel="canonical" href="{{ url |> url(true) }}" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="{{ siteTitle }}" />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:url" content="{{ url |> url(true) }}" />
        <meta property="og:title" content="{{ shareTitle }}" />
        <meta property="og:description" content="{{ shareText }}" />
        <meta property="og:image" content="{{ shareImageUrl }}" />
        <meta property="og:image:width" content="{{ share.width }}" />
        <meta property="og:image:height" content="{{ share.height }}" />
        <meta property="og:image:alt" content="{{ share.alt }}" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="{{ share.twitter }}" />
        <meta name="twitter:title" content="{{ shareTitle }}" />
        <meta name="twitter:description" content="{{ shareText }}" />
        <meta name="twitter:image" content="{{ shareImageUrl }}" />

        <link rel="stylesheet" href="/style.css">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
            rel="stylesheet"
        />
        {{# One deferred script for every page; its initialisers check for their markup. #}}
        <script src="/assets/theme.js" defer></script>
        {{ head }}
    </head>
    <body class="{{ bodyClass || 'bg-gray-50 text-gray-900' }}">
        {{ content }}
    </body>
</html>
