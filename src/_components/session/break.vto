{{#
    Agenda cell for a break: title, time and a one-line note, not clickable;
    fills its grid cell. Props: session (a break from schedule.ts), wide
    (true when it spans every track: the time moves right, the room is left out).
#}}
<div class="flex h-full flex-col justify-center gap-2 rounded-2xl border border-dashed border-gray-300 bg-gray-100 px-5 py-4 text-gray-600 {{ if wide }}sm:flex-row sm:items-center sm:gap-4{{ /if }}">
    <div class="flex flex-1 items-center gap-4">
        {{ comp.ui.icon({ name: session.icon, classes: "w-6 shrink-0 text-center text-xl text-gray-400" }) }}
        <div class="min-w-0">
            <p class="font-semibold text-gray-700">{{ session.title |> escape }}</p>
            {{ if session.paragraphs.length }}
                <p class="mt-1 text-sm">{{ session.paragraphs[0] |> escape }}</p>
            {{ /if }}
            {{ if !wide }}
                <p class="mt-1 text-sm tabular-nums">
                    <time datetime="{{ session.startsAt }}">{{ session.start }}</time>
                    &ndash;
                    <time datetime="{{ session.endsAt }}">{{ session.end }}</time>
                    {{# The room column header covers this on desktop. #}}
                    {{ if session.room }}
                        <span class="md:hidden">&middot; {{ session.room |> escape }}</span>
                    {{ /if }}
                </p>
            {{ /if }}
        </div>
    </div>
    {{ if wide }}
        <p class="pl-10 text-sm tabular-nums sm:pl-0">
            <time datetime="{{ session.startsAt }}">{{ session.start }}</time>
            &ndash;
            <time datetime="{{ session.endsAt }}">{{ session.end }}</time>
        </p>
    {{ /if }}
</div>
