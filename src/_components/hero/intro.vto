{{#
    The hero's opening lines: an optional badge, the heading, the date and
    venue lines, an optional tagline and lede, in white for `hero.frame`.
    The date is `event.date`, the venue line `venue.name` (left out without
    a venue); the copy is the page's.

        {{ comp.hero.intro({ badge: "Tickets available", tagline: "...", lede: "..." }) }}

    Props (all optional):
        title    default "<event.name> <event.year>"
        badge    the pill above the heading; plain or timed text (ui.text)
        tagline  first row under the venue line
        lede     second row; plain or timed text
        size     lg (default) or md, for a smaller frame
#}}
{{ set heading = title || `${event.name} ${event.year}` }}
{{ set compact = size == "md" }}
{{ set hasVenue = venue?.name }}

{{ if badge }}
    <span class="mb-6 inline-block rounded-full bg-accent px-4 py-1 text-sm font-semibold uppercase tracking-widest text-white shadow-lg">
        {{ comp.ui.text({ value: badge }) }}
    </span>
{{ /if }}
<h1 class="mb-4 font-bold leading-tight drop-shadow-lg {{ if compact }}text-4xl md:text-5xl{{ else }}text-5xl md:text-7xl{{ /if }}">
    {{ heading }}
</h1>
<p class="font-semibold drop-shadow-md {{ if hasVenue }}mb-2{{ else }}mb-8{{ /if }} {{ if compact }}text-xl md:text-2xl{{ else }}text-2xl md:text-3xl{{ /if }}">
    {{ comp.ui.icon({ name: "fa-calendar-days", classes: "mr-2 text-white/80" }) }}
    <time datetime="{{ event.date.iso }}">{{ event.date.label }}</time>
</p>
{{ if hasVenue }}
    <p class="mb-8 font-semibold drop-shadow-md {{ if compact }}text-lg md:text-xl{{ else }}text-xl md:text-2xl{{ /if }}">
        {{ comp.ui.icon({ name: "fa-location-dot", classes: "mr-2 text-white/80" }) }}
        {{ venue.name }}
    </p>
{{ /if }}
{{ if tagline || lede }}
    <p class="mb-8 text-white/95 drop-shadow-md {{ if compact }}text-lg md:text-xl{{ else }}text-xl md:text-2xl{{ /if }}">
        {{ if tagline }}
            <span class="block">{{ tagline }}</span>
        {{ /if }}
        {{ if lede }}
            <span class="block">{{ comp.ui.text({ value: lede }) }}</span>
        {{ /if }}
    </p>
{{ /if }}
